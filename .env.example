# -----------------------------------------------------------------------------
# Web UI
# -----------------------------------------------------------------------------
# Port and host interface exposed by Docker Compose.
WEB_PORT=3000
WEB_BIND_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# FreeToken
# -----------------------------------------------------------------------------
# The main docker-compose.yml always uses managed mode. The external Compose file
# always uses external mode, so this value mainly applies to direct/dev launches.
FREETOKEN_MODE=managed
FREETOKEN_PORT=1919
API_BIND_ADDRESS=0.0.0.0

# External Mode endpoint. Use host.docker.internal for a server on the Docker host,
# or a LAN/Docker DNS address for another machine.
FREETOKEN_EXTERNAL_URL=http://host.docker.internal:1919

# Optional administrator-controlled flags appended to managed `ft serve` launches.
FREETOKEN_EXTRA_ARGS=
FREETOKEN_EXECUTABLE=ft

# -----------------------------------------------------------------------------
# Storage (host paths mounted into the managed container)
# -----------------------------------------------------------------------------
MODELS_PATH=./models
DATA_PATH=./data
HF_CACHE_PATH=./hf-cache

# -----------------------------------------------------------------------------
# Hugging Face
# -----------------------------------------------------------------------------
# Required only for private or gated repositories. This value stays server-side.
HF_TOKEN=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Disabled for a zero-step first launch. Enable before exposing the UI outside a
# trusted LAN/VPN, then set a long unique password below.
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set true only when the browser reaches the UI over HTTPS.
SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# Networking / API
# -----------------------------------------------------------------------------
# Public URL shown in copy-ready client examples, for example:
# http://192.168.1.20:1919 or https://freetoken-api.example.net
PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Image and advanced lifecycle settings
# -----------------------------------------------------------------------------
# Pin a release such as v1.0.0 instead of latest when reproducibility matters.
IMAGE_TAG=latest
ALLOWED_IMPORT_DIRS=
METRICS_INTERVAL_SECONDS=2
ENGINE_READY_TIMEOUT_SECONDS=900
ENGINE_STOP_TIMEOUT_SECONDS=20
