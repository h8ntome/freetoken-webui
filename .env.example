# Browser UI port on the Ubuntu host.
WEB_PORT=3000

# managed: this container owns one ft serve process and enables full lifecycle controls.
# external: connect read-only/lifecycle-disabled to FREETOKEN_EXTERNAL_URL.
FREETOKEN_MODE=managed
FREETOKEN_PORT=1919
FREETOKEN_EXTERNAL_URL=http://host.docker.internal:1919

# Host paths mounted into the container. Existing checkpoints can live under MODELS_PATH.
MODELS_PATH=./models
DATA_PATH=./data
HF_CACHE_PATH=./hf-cache

# Optional token for gated/private Hugging Face repositories. It never reaches the browser.
HF_TOKEN=

# Management authentication. Set a strong password before first start.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECURE_COOKIES=false

# The address other machines should use for FreeToken's native inference API.
# Example: http://192.168.1.20:1919 or https://freetoken-api.example.com
PUBLIC_API_BASE_URL=

# Optional current FreeToken serve overrides. Prefer the UI's per-load settings or Auto.
FREETOKEN_EXTRA_ARGS=
ENGINE_READY_TIMEOUT_SECONDS=900
ENGINE_STOP_TIMEOUT_SECONDS=20
